		"lint": "prettier --check . && eslint .",
		"start": "node build"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-node": "^5.5.8",
